"smart_blocks:3_Hardware_Design/Reverse charge protection.md###**Порада:** Якщо ви проектуєте плату, не ставте ці компоненти впритул один до одного. У разі помилки користувача резистор **R24** може сильно нагрітися перед тим, як спрацює інший захист, тому краще дати йому трохи простору для охолодження.": {"path":null,"last_embed":{"hash":"9r6svx","at":1775833560942},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.08471279,0.00239334,-0.00669855,0.01316708,0.00054721,-0.02216499,-0.0066848,0.10851847,-0.00987887,-0.00086052,-0.01361576,-0.05656374,0.02389842,-0.01953628,0.00478156,0.01711287,0.04844187,0.00753722,-0.06165014,0.02348819,0.10503894,-0.08728473,0.00913949,-0.06803596,0.03399495,0.03544172,0.01246077,0.0038467,-0.01721288,-0.19452953,0.04808202,-0.02879959,0.0068196,-0.01169086,-0.02645656,-0.0275091,-0.07919282,-0.01951277,-0.03940943,0.06219508,-0.00367336,0.00360709,-0.04590029,-0.05341299,0.00183798,-0.01121675,-0.0549249,-0.02683268,0.02123048,0.00612991,0.01436307,0.02372084,0.02867522,-0.01834745,0.01878531,-0.01674527,0.08631835,0.04359979,0.08245482,0.00879086,0.02313039,0.00851925,-0.21481937,0.04406617,0.00129619,0.02829677,0.02125997,-0.0065309,0.05084302,0.08412459,-0.0218442,0.01528033,-0.0159153,0.05330538,-0.01425615,-0.02952031,-0.01389312,-0.00053395,-0.04199836,-0.04844245,0.03267152,0.02259483,-0.00557232,-0.02708143,-0.03512884,-0.0326832,0.02353171,0.0147765,0.02308796,0.03862863,-0.03829714,-0.01022485,0.05598056,0.01809843,-0.08117222,0.01266625,0.05108691,0.01850737,-0.06802261,0.11566188,-0.02414451,0.02450534,0.0051435,-0.04407993,0.05384143,-0.1002401,-0.01173664,-0.01699335,-0.03922307,-0.01251568,-0.01689103,0.00719306,0.04993772,-0.04210885,0.03501813,0.08528762,-0.00607301,0.02144365,0.01895021,-0.08443403,-0.01194643,0.03288227,0.02457123,-0.03153426,0.03517147,-0.02466664,-0.00553178,0.08975587,0.02470418,0.08766,0.00544048,-0.02436447,-0.01853968,0.02322157,0.02571747,0.03351931,-0.05949538,0.05569761,0.04546115,-0.046
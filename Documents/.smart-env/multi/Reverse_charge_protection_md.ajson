"smart_blocks:Reverse charge protection.md###**Порада:** Якщо ви проектуєте плату, не ставте ці компоненти впритул один до одного. У разі помилки користувача резистор **R24** може сильно нагрітися перед тим, як спрацює інший захист, тому краще дати йому трохи простору для охолодження.": {"path":null,"last_embed":{"hash":"9r6svx","at":1775389655907},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.08877505,0.00767627,-0.02073698,0.01568381,0.01551123,-0.0118279,0.04124397,0.11015003,-0.01777483,-0.00253245,-0.04094005,-0.04667272,-0.00109574,0.02770394,-0.0105285,0.027103,0.04720506,-0.00783907,-0.0970652,0.04078577,0.10395069,-0.07774784,0.02301759,-0.06344046,0.05365929,0.03436353,0.00122064,-0.00217761,-0.02736313,-0.19392738,0.04980205,-0.03680327,-0.0116732,0.01400172,-0.01357252,-0.01265305,-0.06977303,-0.02486114,-0.03347468,0.06431072,0.00350324,-0.00086635,-0.03350927,-0.06463264,-0.00477951,-0.00165346,-0.04500926,-0.00390424,0.01387179,0.04328407,0.02844995,0.01833272,0.00326534,-0.00964779,0.03185966,-0.01753203,0.08501687,0.03821629,0.08690772,0.01659856,0.01328369,-0.02018679,-0.22781841,0.0311977,-0.00319175,0.01654232,0.006752,0.02488464,0.05294979,0.06368696,-0.02994587,-0.00115766,-0.05162238,0.06607138,-0.02648512,-0.03754273,-0.02613421,0.01493926,-0.02659759,-0.0383172,0.02802976,0.040083,0.00081777,-0.03237607,-0.02587849,-0.03670408,0.03632943,-0.02444721,0.0555252,0.03821325,-0.01143111,-0.02515511,0.07770693,0.03964699,-0.09245907,-0.00170976,0.05529307,0.0333448,-0.03060647,0.1148661,-0.04056934,0.04738824,-0.01337131,-0.05073674,0.03079635,-0.1008355,0.00556779,-0.01233496,-0.00361963,-0.02414745,-0.02328078,-0.0070986,0.06500802,-0.07296432,-0.00793128,0.08179475,0.03720316,0.04656857,-0.0029218,-0.08178119,-0.00094628,0.01350024,0.04053407,-0.03112283,0.01809057,-0.01644347,-0.00472281,0.08574731,0.02758633,0.09632672,0.03044024,-0.03144931,-0.03083992,0.00916849,0.01905015,0.01301303,-0.05269078,0.05090641,0.04820277,-0.03915048,0.008649